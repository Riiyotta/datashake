{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "datashake-design-repo/pagespec.schema.json",
  "title": "Datashake PageSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageSpecVersion",
    "template",
    "route",
    "contentProvenance",
    "nodes"
  ],
  "properties": {
    "pageSpecVersion": {
      "const": "1.0.0"
    },
    "template": {
      "enum": [
        "template.home-landing"
      ]
    },
    "route": {
      "type": "string",
      "pattern": "^/([a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*)?$"
    },
    "contentProvenance": {
      "enum": [
        "source-reproduction",
        "new-page"
      ]
    },
    "sourceContentNotice": {
      "const": "Source content reproduced from www.datashake.com (a real, live company) for fidelity reference only. Not licensed for reuse in new pages."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contentProvenance": {
            "const": "source-reproduction"
          }
        },
        "required": [
          "contentProvenance"
        ]
      },
      "then": {
        "required": [
          "sourceContentNotice"
        ]
      }
    }
  ],
  "definitions": {
    "assetRole": {
      "enum": [
        "brand-logo",
        "customer-logo",
        "product-screenshot",
        "product-lottie",
        "use-case-illustration",
        "ui-icon",
        "social-icon",
        "decorative-pattern"
      ]
    },
    "href": {
      "type": "string",
      "pattern": "^(https://|/|#)"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetRole",
        "assetRef"
      ],
      "properties": {
        "assetRole": {
          "$ref": "#/definitions/assetRole"
        },
        "assetRef": {
          "type": "string",
          "pattern": "^(public/|inline:|generate:|placeholder:)"
        },
        "alt": {
          "type": "string",
          "maxWords": 44,
          "x-observedMaxWords": 35
        }
      }
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxWords": 7,
          "x-observedMaxWords": 5
        },
        "href": {
          "$ref": "#/definitions/href"
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "reducedMotionFallback",
        "fallbackSource"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "dropdown-reveal",
              "hamburger-morph",
              "mobile-menu-slide",
              "hero-word-rotator",
              "lottie-scroll-scrub",
              "lottie-play-once-on-view",
              "lottie-loop",
              "nav-logo-spin",
              "logo-hover-crossfade",
              "button-hover",
              "typed-text-loop",
              "p5-bar-field",
              "tabs-autoadvance",
              "testimonial-panel-switch",
              "faq-accordion",
              "link-color-hover"
            ]
          }
        },
        "reducedMotionFallback": {
          "type": "string",
          "minLength": 8
        },
        "fallbackSource": {
          "const": "prescriptive-design-repo-policy"
        }
      }
    },
    "content_shell-navbar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand",
        "menus",
        "loginCta",
        "bookCta"
      ],
      "properties": {
        "brand": {
          "allOf": [
            {
              "$ref": "#/definitions/media"
            },
            {
              "properties": {
                "assetRole": {
                  "enum": [
                    "brand-logo"
                  ]
                }
              }
            }
          ]
        },
        "menus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "columns",
              "items"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxWords": 2,
                "x-observedMaxWords": 1
              },
              "columns": {
                "enum": [
                  1,
                  2
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "description",
                    "href",
                    "icon"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxWords": 7,
                      "x-observedMaxWords": 5
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxWords": 8,
                      "x-observedMaxWords": 6
                    },
                    "href": {
                      "$ref": "#/definitions/href"
                    },
                    "icon": {
                      "allOf": [
                        {
                          "$ref": "#/definitions/media"
                        },
                        {
                          "properties": {
                            "assetRole": {
                              "enum": [
                                "ui-icon"
                              ]
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "loginCta": {
          "$ref": "#/definitions/cta"
        },
        "bookCta": {
          "$ref": "#/definitions/cta"
        }
      }
    },
